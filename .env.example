# Which LLM provider to use: groq, openai, anthropic or google. Blank = groq.
# Only groq has been tested live (see README).
LLM_PROVIDER=groq

# The API key for the provider above (one key, whichever provider you chose)
LLM_API_KEY=

# Optional: a model name. Blank = the provider's default (groq: openai/gpt-oss-120b)
LLM_MODEL=

# The date the app treats as "today"
APP_TODAY=2026-07-01

# Data files (the defaults point at ./data)
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db
