# Copy this file to .env and edit. Real environment variables override .env.
# Never put a real key in this file.

# Input files (the defaults point at ./data)
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db

# The date the app treats as "today"
APP_TODAY=2026-07-01

# LLM. Groq is the provider that is implemented and tested.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20

# API key. Precedence: LLM_API_KEY first, otherwise the provider's own variable
# (GROQ_API_KEY for groq, OPENAI_API_KEY for openai). Blank values count as unset.
# ANTHROPIC_API_KEY and GOOGLE_API_KEY are recognised but have no adapter yet.
LLM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
